# Generate fresh values on the target host. Never commit the real file.
# Example:
#   umask 077
#   printf 'BETTER_AUTH_SECRET=%s\nHEMMELIG_ANALYTICS_HMAC_SECRET=%s\n' \
#     "$(openssl rand -base64 48 | tr -d '\n')" \
#     "$(openssl rand -base64 48 | tr -d '\n')" > .env

BETTER_AUTH_SECRET=replace-with-random-32-plus-character-secret
HEMMELIG_ANALYTICS_HMAC_SECRET=replace-with-separate-random-secret
